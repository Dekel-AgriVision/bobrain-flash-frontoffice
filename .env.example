# ── Next-Auth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# ── API BOBRAINFLASHAPI ───────────────────────────────────
# Origine de l'API vue par le serveur Next (login + proxy /flash-backend/api/v1)
API_ORIGIN=http://127.0.0.1:3336
# Préfixe des routes API (swagger : http://[::1]:3336/flash-backend/api/v1/swagger)
NEXT_PUBLIC_API_PREFIX=/flash-backend/api/v1
# Socket.IO (namespace /ws) — joignable par le NAVIGATEUR
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3336/ws

# ── Session ───────────────────────────────────────────────
# Inactivité (minutes) avant retour à la page de connexion
NEXT_PUBLIC_SESSION_IDLE_MINUTES=10
# Renouvellement du token API (minutes) tant que l'utilisateur est actif
NEXT_PUBLIC_SESSION_REFRESH_MINUTES=20
